acrcloud:
  access_key: "ACCESS_KEY_HERE"
  secret_key: "SECRET_KEY_HERE"
  host: "identify-eu-west-1.acrcloud.com"

overlay:
  font_size: 18
  font_family: "Inter, Segoe UI, Roboto"
  position: "center"
  opacity: 0.55

detection:
  interval: 15  # seconds between audio detection attempts (Linux/macOS only)

lyrics:
  lrclib_url: "https://lrclib.net/api/search"
  netease_search_url: "https://music.163.com/api/search/get"
  netease_lyrics_url: "https://music.163.com/api/song/lyric"
